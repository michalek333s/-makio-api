# ═══════════════════════════════════════════════════════════════
#  NEMIO BACKEND — Environment Variables
#  Zkopírujte tento soubor jako .env a doplňte klíče
#  NIKDY nekomerujte .env do gitu! Je v .gitignore.
# ═══════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Production CORS — povinné, jinak backend nestartuje
# FRONTEND_URLS=https://app.makio.cz,https://makio.cz,https://www.makio.cz
# FRONTEND_URL=https://app.makio.cz
# Za nginx / load balancerem kvůli rate limitu (správná klientská IP)
# TRUST_PROXY=1
# Ve výrobě: /api/health bez „services“ mapy (méně informací útočníkovi). Pro monitoring nastavte:
# HEALTH_DETAIL=1

# ─── GeoPas API ──────────────────────────────────────────────────
# Token z GeoPas (query parametr t=…) — NIKDY do frontendu
GEOPAS_API_KEY=

# GeoPas agent v chatu (Claude tool-use) vyžaduje zároveň ANTHROPIC_API_KEY níže
# Dev server (e-mail od GeoPas) — připojení na IP, certifikát zůstává geopas.cz
# GEOPAS_DEV_IP=85.207.0.17

# WSDP / vlastník z LV (wsdpLvByLand)
# GEOPAS_WSDP_TEST=true  → vždy ukázkové LV; UI NEUKAZUJE jméno vlastníka (vypadalo by jako realita)
# GEOPAS_WSDP_TEST=false + LOGIN/PASSWORD → živý vlastník/LV
# GEOPAS_WSDP_LOGIN=
# GEOPAS_WSDP_PASSWORD=
GEOPAS_WSDP_TEST=true
GEOPAS_WSDP_DEV_LOGIN=test
GEOPAS_WSDP_DEV_PASSWORD=test

# ─── AI APIs ─────────────────────────────────────────────────────
# Chat + CRM JSON: Claude (Anthropic) NEBO Gemini — klíče jen zde, nikdy ve frontendu.
# Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model (výchozí Sonnet 4; podle dostupnosti účtu změňte)
# CLAUDE_MODEL=claude-sonnet-4-20250514
# ─── Routování AI (úspora kreditů Claude) ─────────────────────────
# CHAT_PROVIDER=gemini          # gemini | claude | auto (auto = Gemini preferuje)
# GEOPAS_CHAT_MODE=pipeline      # pipeline | claude | auto
#   pipeline = GeoPas API + krátké Gemini shrnutí (levné, bez Claude agenta)
#   claude = plný Claude tool-use agent (drahé)
#   auto = pipeline, kromě GEOPAS_CHAT_AUTO_CLAUDE=1 + budget
# GEOPAS_PIPELINE_GEMINI_WRAP=0   # 1 = další Gemini volání navíc (dražší)
# GEOPAS_CHAT_AUTO_CLAUDE=0      # 1 = v režimu auto povolit Claude agenta
# CLAUDE_DAILY_BUDGET=20        # max Claude volání / den (0 = neomezeno)
# CLAUDE_BUDGET_GEOPAS=5        # podlimit pro GeoPas agenta
# CLAUDE_BUDGET_CHAT=15         # podlimit pro chat + SMS + polish
# CLAUDE_RETRY_ATTEMPTS=3

# Gemini (chat jako fallback; Radar skóre apod. stále Gemini kde je v kódu) — https://aistudio.google.com
GEMINI_API_KEY=
# Volitelně: model (výchozí gemini-2.5-flash; starší gemini-2.0-flash u nových účtů nefunguje)
# GEMINI_MODEL=gemini-2.5-flash
# Fallback modely při 404/503 (oddělené čárkou)
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
# Retry při 429/5xx
# GEMINI_RETRY_ATTEMPTS=3

# Radar — AI skóre náběrového potenciálu (Gemini).
# Scan je výchozí RYCHLÝ (jen heuristika). Hloubkové Gemini u jednoho inzerátu: POST /api/radar/score-lead (volá frontend po výběru).
# Cache inzerátů z Apify (Bezrealitky/Bazoš) — RAM + Supabase radar_listing_cache (migrace 0017)
# RADAR_CACHE_ENABLED=1
# RADAR_CACHE_TTL_HOURS=12
# Scan jen z cache (výchozí ON — vypnout: RADAR_CACHE_ONLY=0)
# RADAR_CACHE_ONLY=0
# Live scrape / poll (výchozí OFF). Funguje jen spolu s RADAR_CACHE_ONLY=0.
# RADAR_LIVE_SCRAPE=1
# RADAR_POLL_BAZOS_MS=300000
# RADAR_POLL_BEZREALITKY_MS=600000
# RADAR_POLL_SREALITY_MS=900000
# Volitelný HTTP proxy pro veřejný fetch (ne bypass WAF)
# RADAR_PROXY_URL=
# Tabulky Anti-RK poolu (SQL Editor): supabase/migrations/0025_radar_v2_listings.sql
# Zápis do radar_listings / reference_agency_listings / broker_blacklist (výchozí ON, když je service_role)
# RADAR_V2_PERSIST=0
# Demo fallback — jen Moravskoslezský (Ostrava…). Jiné kraje → prázdná cache + varování.
# Demo fallback — VYPNUTO. Zapněte jen když schválně chcete falešné inzeráty MSK.
# RADAR_DEMO_FALLBACK=1
# Background enrich při startu backendu + každých N hodin
# RADAR_BG_ENRICH=1
# RADAR_BG_REGIONS=Moravskoslezský
# RADAR_BG_PROPERTY_TYPES=byty
# RADAR_BG_REFRESH_HOURS=6
# Radar Watchdog — Apify webhook (POST /api/webhooks/radar)
# APIFY_WEBHOOK_SECRET=long-random-string
# RADAR_DELTA_MAX_PAGES=3
# RADAR_DELTA_MAX_LISTINGS=120
# RADAR_PRICE_DROP_ALERT_MIN=100000
# RESEND_API_KEY=
# RESEND_FROM=Makio Radar <radar@makio.cz>
# TTL hotových scan výsledků (Supabase + RAM), výchozí 1 h
# RADAR_SCAN_CACHE_TTL_HOURS=1
# Min. inzerátů v cache → scan přeskočí live Sreality (rychlejší)
# RADAR_CACHE_MIN_LISTINGS=3
# RADAR_SKIP_LIVE_SREALITY=1
# Přímé Sreality /api/cs/v2/estates z VPS/datacenter obvykle vrací 404 — nechte vypnuté.
# Live zapněte jen s residential proxy: RADAR_SREALITY_DIRECT=1 + RADAR_CACHE_ONLY=0 + RADAR_SKIP_LIVE_SREALITY=0
# RADAR_SREALITY_DIRECT=0
# Bazoš enrich (0 = vypnuto, pokud Apify actor vyžaduje schválení)
# RADAR_BAZOS_ENABLED=0
# Facebook Marketplace (Apify actor apify~facebook-marketplace-scraper)
# RADAR_FB_ENABLED=0
# RADAR_FB_ACTOR=apify~facebook-marketplace-scraper
# RADAR_FB_MAX_ITEMS=80
# RK ověření přes Sreality detail API (zdarma, jen při scanu „Jen náběr“)
# RADAR_DETAIL_VERIFY=1
# RADAR_DETAIL_VERIFY_MAX=20
# RADAR_DETAIL_VERIFY_CONCURRENCY=4
# RADAR_SREALITY_MAX_LISTINGS=120
# RADAR_BEZREALITKY_MAX_LISTINGS=120
# RADAR_AI_ON_SCAN=0
# RADAR_AI_DISABLE=0
# Počet inzerátů v jedné dávce (jen při RADAR_AI_ON_SCAN=1), výchozí 8
# RADAR_AI_BATCH_SIZE=8
# Paralelita dávek (jen při RADAR_AI_ON_SCAN=1), výchozí 4
# RADAR_AI_PARALLEL=4
# Radar rate limit (endpoint /api/radar/scan)
# Produkce default: 12 požadavků / hodina / IP.
# Development default: bypass (aby lokální testování nepadalo na limit).
# RADAR_RATE_LIMIT_DEV_BYPASS=1
# RADAR_RATE_LIMIT_WINDOW_MS=3600000
# RADAR_RATE_LIMIT_MAX=12

# OpenAI GPT-4o (copywriting, vision) — https://platform.openai.com
OPENAI_API_KEY=

# Decor8 AI — virtuální staging (https://prod-app.decor8.ai/)
# Alternativa: secret DECOR8_API_KEY na Supabase Edge Function ai-staging
DECOR8_API_KEY=
# Rozlišení výstupu (1–2). Default 2 = až 1536 px, bez příplatku u Decor8.
DECOR8_SCALE_FACTOR=2
# Nižší = věrnější místnosti, méně halucinací (dveře, okna). Default 0.2
DECOR8_DESIGN_CREATIVITY=0.15
# Počet variant z API (1–4). Default 1 = nejbezpečnější pro RK.
DECOR8_NUM_IMAGES=1

# ─── AML modul ────────────────────────────────────────────────────
# OpenSanctions Match API (sankce / PEP screening)
# Docs: https://www.opensanctions.org/docs/api/
OPENSANCTIONS_API_KEY=

# Insolvenční hlídač (ISIR) — https://www.isir.info
# API: username + password (do INSHLIDAC_EMAIL dejte login e-mail)
# Pozn.: inshlidac.cz DNS neexistuje — nepoužívat
INSHLIDAC_BASE_URL=https://www.isir.info
INSHLIDAC_EMAIL=
INSHLIDAC_PASSWORD=

# Rejstriky.info — fallback ISIR, pokud INSHLIDAC_* není vyplněné
# https://www.rejstriky.info
REJSTRIKY_USERNAME=
REJSTRIKY_PASSWORD=

# EU sanctions feed (offline cache — doplněk k OpenSanctions)
EU_SANCTIONS_XML_URL=

# ─── Supabase (databáze + auth) ───────────────────────────────────
# Dashboard → Settings → API → záložka „Legacy anon, service_role API keys“
# Stejná Project URL jako VITE_SUPABASE_URL v nemio-proto/.env
SUPABASE_URL=https://VASE_REF.supabase.co
# anon public — na backendu volitelné; povinné ve frontendu (nemio-proto/.env)
SUPABASE_ANON_KEY=
# service_role secret — POUZE zde (obchází RLS), nikdy do nemio-proto ani do gitu
SUPABASE_SERVICE_ROLE_KEY=

# ─── API auth (Supabase JWT) ───────────────────────────────────
# Když je SUPABASE_URL + SUPABASE_ANON_KEY, všechny /api/* kromě health/waitlist vyžadují Bearer token.
# AUTH_DISABLED=1          # nouzově vypnout gate (NE v produkci)
# AUTH_ALLOW_ANON_DEV=1    # jen NODE_ENV!=production: povolit requesty bez tokenu

# Governance AI feedback — schválení lekcí do system promptu (anti-poisoning)
# FEEDBACK_GOVERNANCE_SECRET=long-random-string
# Header: X-Feedback-Governance-Key: <secret>
# POST /api/ai/feedback/:id/approve · GET /api/ai/feedback/pending

# ─── Apify (Radar — multi-portál úspora) ─────────────────────────
# Konzole: Settings → Integrations → API token · https://console.apify.com
# Doporučeno: Starter + actor martas_kristof/cz-reality-scraper (Try for free)
# Default: 1× CZ Reality = sreality+bezrealitky. Dedicated Sreality (drahý) jen RADAR_DEDICATED_SREALITY=1
# Bazoš ON, Facebook OFF. enableHistory vždy false v kódu.
APIFY_TOKEN=
# RADAR_DEDICATED_SREALITY=0
# RADAR_CZ_PORTALS=sreality
# RADAR_CZ_MAX_LISTINGS=100
# RADAR_BAZOS_ENABLED=1
# RADAR_BAZOS_MAX_ITEMS=60
# RADAR_FB_ENABLED=0
# RADAR_BG_REFRESH_HOURS=12
# RADAR_SREALITY_ACTOR=logiover~sreality-cz-scraper-czech-real-estate-data
# RADAR_SREALITY_MAX_LISTINGS=100

# ─── Smlouvy (vyplnění .docx) ─────────────────────────────────────
# POST /api/contracts/fill — žádný extra klíč; používá se jen docxtemplater + CRM data z payloadu.
# Volitelně: max. požadavků za minutu na IP (výchozí 30 prod / 120 dev)
# CONTRACT_RATE_LIMIT_MAX=30

# ─── Zoom (automatický odkaz na videohovor v agendě) ─────────────
# V Zoom Marketplace vytvořte „Server-to-Server OAuth“ aplikaci:
# https://marketplace.zoom.us/develop/create
# Scopes: meeting:write:admin, user:read:admin (nebo meeting:write + user:read dle účtu)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# E-mail Zoom uživatele, pod kterým se mají schůzky zakládat (nebo přímo userId):
ZOOM_USER_EMAIL=
# ZOOM_HOST_USER_ID=   # volitelně místo e-mailu
# ZOOM_TIMEZONE=Europe/Prague

# ─── Google Calendar (Agenda sync) ───────────────────────────────
# Google Cloud Console → OAuth 2.0 Client (Web application)
# Authorized redirect URI: {BACKEND_PUBLIC_URL}/api/calendar/google/callback
# FRONTEND_URL musí sedět (callback redirect na /?calendar=connected)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pokud backend běží za reverse proxy / na Railway:
# BACKEND_PUBLIC_URL=https://api.vasedomena.cz
GOOGLE_CALENDAR_REDIRECT_URI=
# Migrace: supabase/migrations/0038_*.sql + 0040_*.sql

# ─── Signi e-podpis (smlouvy) ────────────────────────────────────
# https://www.signi.com — API klíč z administrace
SIGNI_API_KEY=

# ─── Landing waitlist (POST /api/waitlist) ───────────────────────
# Vyžaduje migraci 0019_landing_waitlist.sql + SUPABASE_SERVICE_ROLE_KEY výše

# LibreOffice pro PDF export vyplněných smluv (DOCX→PDF)
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# ─── Volitelné (přijde later) ─────────────────────────────────────
# GeoPas cache — vše katastrické ukládat (migrace 0015 + SUPABASE_SERVICE_ROLE_KEY)
GEOPAS_CACHE_ENABLED=true
GEOPAS_CACHE_BACKEND=layered
GEOPAS_CACHE_TTL_HOURS=168
GEOPAS_SEARCH_CACHE_TTL_HOURS=24
# Při cache hit nepouštět Gemini wrap (rychlejší chat): výchozí true
# GEOPAS_PIPELINE_SKIP_WRAP_ON_CACHE=0

# Redis pro produkční cache (volitelné budoucí — GeoPas už používá Supabase)
# REDIS_URL=redis://localhost:6379


# ─── AI Video (Higgsfield image→video) ───────────────────────────
# HF_CREDENTIALS=KEY_ID:KEY_SECRET
# HF_API_KEY=
# HF_API_SECRET=
# HIGGSFIELD_I2V_ENDPOINT=/v1/image2video/dop
# HIGGSFIELD_I2V_MODEL=dop-turbo
# Free test bez placení HF (klíče můžou zůstat): nevolá API, vrátí demo MP4
# HF_FORCE_MOCK=1
# REEL_VIDEO_PROVIDER=mock|wan|seedance|kling|higgsfield
# FAL_KEY=
# Wan 2.2 A14B @ 720p (~$0.40/clip; 480p ~$0.20). Legacy: fal-ai/wan-i2v + 480p
# FAL_WAN_MODEL=fal-ai/wan/v2.2-a14b/image-to-video
# FAL_WAN_RESOLUTION=720p
# FAL_SEEDANCE_MODEL=bytedance/seedance-2.0/fast/image-to-video
# FAL_KLING_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# FFMPEG_PATH=ffmpeg
# REEL_STAGING_CREDITS=1
# REEL_TTS_CREDITS=1
# REEL_COMPOSE_CREDITS=1
# STAGING_VIDEO_CREDITS=2
# STAGING_VIDEO_PRICE_CZK=50
# Closed beta: více welcome kreditů (např. 50); lokálně i DEV_CREDITS_TOPUP
# STAGING_VIDEO_WELCOME_CREDITS=50
# DEV_CREDITS_TOPUP=100
# V production RAM ledger nikdy (fail-closed). Lokálně vynutit stejné chování:
# CREDITS_FAIL_CLOSED=1
# STAGING_VIDEO_ALLOW_MOCK=1

# AI Reel file upload (Supabase Storage bucket)
# REEL_UPLOAD_BUCKET=staging-uploads
# REEL_UPLOAD_MAX_BYTES=12582912
